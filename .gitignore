# Environment — never commit real credentials
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Pytest
.pytest_cache/
.coverage
htmlcov/
# SQLite files the tests create in the repo root (sqlite:///./test_*.db)
test_*.db

# Mypy
.mypy_cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Kubernetes — never commit filled-in secret manifests
# secret-template.yaml (with <REPLACE_ME> values) is committed; any file
# with real values should be named differently and caught by these patterns.
k8s/secret.yaml
k8s/*-real.yaml
k8s/*-secrets.yaml
